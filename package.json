{
  "name": "applaud",
  "version": "0.5.12",
  "private": true,
  "description": "Self-hosted server that mirrors Plaud recordings to local disk and triggers webhooks on new uploads.",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,srv -c cyan,magenta \"pnpm -C web dev\" \"pnpm -C server dev\"",
    "build": "pnpm -C shared build && pnpm -C web build && pnpm -C server build",
    "start": "pnpm build && node server/dist/index.js",
    "start:nobuild": "node server/dist/index.js",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @applaud/shared build && vitest run",
    "test:watch": "vitest",
    "coverage": "pnpm --filter @applaud/shared build && vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean && node -e \"fs.rmSync('node_modules',{recursive:true,force:true})\""
  },
  "pnpm": {
    "overrides": {
      "sherpa-onnx-darwin-arm64": "1.12.28",
      "sherpa-onnx-darwin-x64": "1.12.28",
      "sherpa-onnx-linux-arm64": "1.12.28",
      "sherpa-onnx-linux-x64": "1.12.28",
      "sherpa-onnx-win-ia32": "1.12.28",
      "sherpa-onnx-win-x64": "1.12.28"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^2.1.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^2.1.9"
  }
}
