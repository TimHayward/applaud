#!/usr/bin/with-contenv bash
# The viewer gives full control of a browser signed in to Plaud: never serve
# it without a password. Waits here, before the viewer starts, until one is set.
if [ -z "${PASSWORD}" ] && [ -z "${FILE__PASSWORD}" ]; then
  echo "**** applaud-browser: set PASSWORD (APPLAUD_BROWSER_PASSWORD in the stack) to protect the browser viewer. Not starting the viewer until it is set. ****"
  exec sleep infinity
fi
