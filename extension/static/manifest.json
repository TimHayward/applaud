{
  "manifest_version": 3,
  "name": "Applaud: speaker names to Plaud",
  "short_name": "Applaud",
  "version": "0.6.0",
  "description": "Sends the speaker names you confirmed in your own Applaud to Plaud. Unofficial; not affiliated with Plaud.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Applaud", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://web.plaud.ai/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://web.plaud.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
